<!--
  The drawn box lives on MAIN, not on the indicator.

  lv_checkbox sizes its indicator from the FONT — `marker_size = font_h +
  pad_left + pad_right` (lv_checkbox.c:215) — and never reads a width or
  height style for it. So a 24x24 box drawn in Figma has no way to carry
  its pixel size through the indicator, and comes out at whatever the
  theme font's line height happens to be.

  MAIN takes explicit width/height, so we draw the box there and zero the
  indicator instead. The marker still occupies its font-derived area
  internally; it is simply invisible, which makes its size irrelevant and
  removes any need to pin a font to control geometry.

  The checked look also belongs on main: state and styled surface must be
  the SAME object. A child element would render above the indicator (children
  draw after their parent) but would not inherit the parent's CHECKED state.

  Labels are never consumed into the widget — a TEXT node beside the box in
  Figma emits as a sibling lv_label, so main is only ever the box.
-->
<component>
  <styles>
    <!-- Default box: what a <checkbox/> looks like with no design styling
         resolved (the emitter's null-return fallback). Generated components
         override width/height/radius/colors with the drawn values. -->
    <style
      name="style_main"
      width="20"
      height="20"
      bg_color="#const_baselib_accent_global"
      bg_opa="24%"
      border_color="#const_baselib_accent_global"
      border_width="2"
      radius="#const_baselib_radius_global"
      pad_all="0" />
    <style name="style_main_checked" bg_color="#const_baselib_accent_global" bg_opa="100%" />
    <!-- The marker is deliberately not drawn — see the note above. Zeroed
         explicitly rather than left to remove_style_all so a theme can't
         reintroduce it. -->
    <style name="style_indicator_off" bg_opa="0" border_width="0" pad_all="0" />
  </styles>
  <view extends="lv_checkbox">
    <remove_style_all />
    <style name="style_main" />
    <style name="style_main_checked" selector="checked" />
    <style name="style_indicator_off" selector="indicator" />
  </view>
</component>
